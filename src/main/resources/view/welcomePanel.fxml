<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXToggleButton?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="727.0" prefWidth="864.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.assignment.tictactoe.controller.WelcomePanelController">
   <children>
      <Pane fx:id="gamePane" layoutY="-1.0" prefHeight="630.0" prefWidth="864.0" style="-fx-background-color: white;">
         <children>
            <Label alignment="CENTER" layoutX="9.0" layoutY="28.0" prefHeight="161.0" prefWidth="846.0" text="Tic-Tac-Toe" textFill="RED">
               <font>
                  <Font name="Papyrus" size="48.0" />
               </font>
            </Label>
            <Label alignment="CENTER" layoutX="159.0" layoutY="237.0" prefHeight="72.0" prefWidth="547.0" text="Enter Your Name" textFill="BLUE">
               <font>
                  <Font name="Papyrus" size="24.0" />
               </font>
            </Label>
            <TextField fx:id="nameText" alignment="CENTER" layoutX="253.0" layoutY="315.0" prefHeight="63.0" prefWidth="374.0" style="-fx-background-radius: 30;">
               <font>
                  <Font name="Papyrus" size="24.0" />
               </font>
               <effect>
                  <DropShadow />
               </effect>
            </TextField>
            <Button fx:id="playButton" layoutX="331.0" layoutY="501.0" mnemonicParsing="false" onAction="#play" prefHeight="72.0" prefWidth="216.0" style="-fx-background-radius: 30; -fx-border-color: blue; -fx-border-radius: 30;" text="Play" textFill="RED" visible="false">
               <font>
                  <Font name="Papyrus" size="24.0" />
               </font>
               <effect>
                  <DropShadow>
                     <color>
                        <Color blue="1.0" />
                     </color></DropShadow>
               </effect>
            </Button>
            <JFXToggleButton fx:id="easyModeToggleBtn" layoutX="363.0" layoutY="397.0" onAction="#setMode" prefHeight="80.0" prefWidth="153.0" text="Easy mode" textFill="BLUE" toggleColor="RED" unToggleColor="BLUE">
               <font>
                  <Font name="Papyrus" size="12.0" />
               </font>
            </JFXToggleButton>
         </children>
      </Pane>
      <Button fx:id="replayButton" layoutX="330.0" layoutY="641.0" mnemonicParsing="false" onAction="#replay" prefHeight="72.0" prefWidth="210.0" style="-fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: blue;" text="Replay" textFill="RED">
         <font>
            <Font name="Papyrus" size="22.0" />
         </font>
         <effect>
            <DropShadow>
               <color>
                  <Color blue="1.0" />
               </color></DropShadow>
         </effect>
      </Button>
   </children>
</AnchorPane>
